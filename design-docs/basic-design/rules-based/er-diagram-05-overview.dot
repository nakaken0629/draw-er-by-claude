digraph er {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=0.9, bgcolor=white,
         fontname="Hiragino Sans", label="トランザクション関連の統合図", labelloc=t, fontsize=20, margin=0.3];
  node [shape=plain, fontname="Hiragino Sans"];
  edge [fontname="Hiragino Sans"];
  supplier [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>仕入れ先</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">supplier</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">仕入れ先ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">supplier_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  member_so [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fffde7"><TR><TD BGCOLOR="#f9a825" COLSPAN="3" CELLPADDING="6"><FONT COLOR="black"><B>会員</B></FONT><BR/><FONT COLOR="black" POINT-SIZE="10">member</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">会員ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  member_sh [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fffde7"><TR><TD BGCOLOR="#f9a825" COLSPAN="3" CELLPADDING="6"><FONT COLOR="black"><B>会員</B></FONT><BR/><FONT COLOR="black" POINT-SIZE="10">member</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">会員ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  product_po [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  product_si [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  product_so [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  product_out [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  product_st [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  purchase_order [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>仕入れ</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">purchase_order</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">仕入れID<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_order_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  purchase_order_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>仕入れ明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">purchase_order_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">仕入れ明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_order_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  stock_in [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>入庫</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_in</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">入庫ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_in_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  stock_in_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>入庫明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_in_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">入庫明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_in_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  sales_order [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>受注</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">sales_order</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">受注ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">sales_order_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  sales_order_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>受注明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">sales_order_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">受注明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">sales_order_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  shipment [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>出荷</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">shipment</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">出荷ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">shipment_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  stock_out [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>出庫</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_out</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">出庫ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_out_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  stock_taking [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>棚卸し</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_taking</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">棚卸しID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_taking_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  stock_taking_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>棚卸し明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_taking_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">棚卸し明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_taking_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
  { rank=same; supplier; member_so; product_st; }
  { rank=same; purchase_order; purchase_order_detail; product_po; sales_order; sales_order_detail; product_so; stock_taking; stock_taking_detail; }
  { rank=same; stock_in; stock_in_detail; product_si; shipment; member_sh; }
  { rank=same; stock_out; product_out; }
  supplier -> purchase_order [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="発注先となる", fontsize=10, fontname="Hiragino Sans"];
  purchase_order -> purchase_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  product_po -> purchase_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="発注対象となる", fontsize=10, fontname="Hiragino Sans"];
  purchase_order -> stock_in [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="分納して入庫される", fontsize=10, fontname="Hiragino Sans"];
  stock_in -> stock_in_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  purchase_order_detail -> stock_in_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="入庫実績を持つ", fontsize=10, fontname="Hiragino Sans"];
  product_si -> stock_in_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="入庫対象となる", fontsize=10, fontname="Hiragino Sans"];
  member_so -> sales_order [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="受注する", fontsize=10, fontname="Hiragino Sans"];
  sales_order -> sales_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  product_so -> sales_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="受注対象となる", fontsize=10, fontname="Hiragino Sans"];
  member_sh -> shipment [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="配送先となる", fontsize=10, fontname="Hiragino Sans"];
  sales_order_detail -> stock_out [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="分割して出庫されうる", fontsize=10, fontname="Hiragino Sans"];
  shipment -> stock_out [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="まとめて出庫されうる", fontsize=10, fontname="Hiragino Sans"];
  product_out -> stock_out [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="出庫対象となる", fontsize=10, fontname="Hiragino Sans"];
  stock_taking -> stock_taking_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  product_st -> stock_taking_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="棚卸し対象となる", fontsize=10, fontname="Hiragino Sans"];
}
