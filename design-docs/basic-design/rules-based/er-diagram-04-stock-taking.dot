digraph er {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=0.9, bgcolor=white,
         fontname="Hiragino Sans", label="棚卸し系列図", labelloc=t, fontsize=20, margin=0.3];
  node [shape=plain, fontname="Hiragino Sans"];
  edge [fontname="Hiragino Sans"];
  product [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">カテゴリID<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品コード<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_code</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品名<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準販売単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_selling_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準仕入単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_purchase_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  stock_taking [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>棚卸し</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_taking</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">棚卸しID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_taking_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">対象年月<BR/><FONT POINT-SIZE="9" COLOR="#555555">target_month</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">実施日<BR/><FONT POINT-SIZE="9" COLOR="#555555">conducted_on</FONT></TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
  stock_taking_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>棚卸し明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_taking_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">棚卸し明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_taking_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">棚卸しID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_taking_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">実棚卸数量<BR/><FONT POINT-SIZE="9" COLOR="#555555">counted_quantity</FONT></TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
  { rank=same; stock_taking; stock_taking_detail; }
  stock_taking -> stock_taking_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  product -> stock_taking_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="棚卸し対象となる", fontsize=10, fontname="Hiragino Sans"];
}
