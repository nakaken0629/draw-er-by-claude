digraph er {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=0.9, bgcolor=white,
         fontname="Hiragino Sans", label="マスター・ステート一覧図", labelloc=t, fontsize=20, margin=0.3];
  node [shape=plain, fontname="Hiragino Sans"];
  edge [fontname="Hiragino Sans"];
  category [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>カテゴリ</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">category</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">カテゴリID<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">カテゴリ名<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
  product [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">カテゴリID<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品コード<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_code</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品名<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準販売単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_selling_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準仕入単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_purchase_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  supplier [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>仕入れ先</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">supplier</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">仕入れ先ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">supplier_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">仕入れ先名<BR/><FONT POINT-SIZE="9" COLOR="#555555">supplier_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
  member [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fffde7"><TR><TD BGCOLOR="#f9a825" COLSPAN="3" CELLPADDING="6"><FONT COLOR="black"><B>会員</B></FONT><BR/><FONT COLOR="black" POINT-SIZE="10">member</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">会員ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">会員名<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">メールアドレス<BR/><FONT POINT-SIZE="9" COLOR="#555555">email</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">配送先住所<BR/><FONT POINT-SIZE="9" COLOR="#555555">shipping_address</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">登録日<BR/><FONT POINT-SIZE="9" COLOR="#555555">registered_on</FONT></TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
  { rank=same; category; supplier; member; }
  category -> product [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="分類する", fontsize=10, fontname="Hiragino Sans"];
}
