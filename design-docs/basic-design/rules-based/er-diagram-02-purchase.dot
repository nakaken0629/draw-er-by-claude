digraph er {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=0.9, bgcolor=white,
         fontname="Hiragino Sans", label="仕入れ系列図（仕入れ→入庫）", labelloc=t, fontsize=20, margin=0.3];
  node [shape=plain, fontname="Hiragino Sans"];
  edge [fontname="Hiragino Sans"];
  supplier [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>仕入れ先</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">supplier</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">仕入れ先ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">supplier_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">仕入れ先名<BR/><FONT POINT-SIZE="9" COLOR="#555555">supplier_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
  purchase_order [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>仕入れ</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">purchase_order</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">仕入れID<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_order_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">仕入れ先ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">supplier_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">発注日<BR/><FONT POINT-SIZE="9" COLOR="#555555">ordered_on</FONT></TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">取消フラグ<BR/><FONT POINT-SIZE="9" COLOR="#555555">is_cancelled</FONT></TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
  purchase_order_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>仕入れ明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">purchase_order_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">仕入れ明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_order_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">仕入れID<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_order_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">発注数量<BR/><FONT POINT-SIZE="9" COLOR="#555555">ordered_quantity</FONT></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">仕入単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_unit_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  product_a [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">カテゴリID<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品コード<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_code</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品名<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準販売単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_selling_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準仕入単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_purchase_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  stock_in [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>入庫</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_in</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">入庫ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_in_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">仕入れID<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_order_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">入庫日<BR/><FONT POINT-SIZE="9" COLOR="#555555">received_on</FONT></TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
  stock_in_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>入庫明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_in_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">入庫明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_in_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">入庫ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_in_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">仕入れ明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">purchase_order_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">入庫数量<BR/><FONT POINT-SIZE="9" COLOR="#555555">received_quantity</FONT></TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
  product_b [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">カテゴリID<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品コード<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_code</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品名<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準販売単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_selling_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準仕入単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_purchase_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  { rank=same; purchase_order; purchase_order_detail; product_a; }
  { rank=same; stock_in; stock_in_detail; product_b; }
  supplier -> purchase_order [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="発注先となる", fontsize=10, fontname="Hiragino Sans"];
  purchase_order -> purchase_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  product_a -> purchase_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="発注対象となる", fontsize=10, fontname="Hiragino Sans"];
  purchase_order -> stock_in [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="分納して入庫される", fontsize=10, fontname="Hiragino Sans"];
  stock_in -> stock_in_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  purchase_order_detail -> stock_in_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="入庫実績を持つ", fontsize=10, fontname="Hiragino Sans"];
  product_b -> stock_in_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="入庫対象となる", fontsize=10, fontname="Hiragino Sans"];
}
