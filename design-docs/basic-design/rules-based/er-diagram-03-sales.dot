digraph er {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=0.9, bgcolor=white,
         fontname="Hiragino Sans", label="受注・出荷系列図（受注→出庫←出荷）", labelloc=t, fontsize=20, margin=0.3];
  node [shape=plain, fontname="Hiragino Sans"];
  edge [fontname="Hiragino Sans"];
  member [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fffde7"><TR><TD BGCOLOR="#f9a825" COLSPAN="3" CELLPADDING="6"><FONT COLOR="black"><B>会員</B></FONT><BR/><FONT COLOR="black" POINT-SIZE="10">member</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">会員ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">会員名<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">メールアドレス<BR/><FONT POINT-SIZE="9" COLOR="#555555">email</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">配送先住所<BR/><FONT POINT-SIZE="9" COLOR="#555555">shipping_address</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">登録日<BR/><FONT POINT-SIZE="9" COLOR="#555555">registered_on</FONT></TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
  sales_order [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>受注</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">sales_order</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">受注ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">sales_order_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">会員ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">受注日<BR/><FONT POINT-SIZE="9" COLOR="#555555">ordered_on</FONT></TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">取消フラグ<BR/><FONT POINT-SIZE="9" COLOR="#555555">is_cancelled</FONT></TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
  sales_order_detail [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>受注明細</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">sales_order_detail</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">受注明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">sales_order_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">受注ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">sales_order_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">受注数量<BR/><FONT POINT-SIZE="9" COLOR="#555555">ordered_quantity</FONT></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">販売単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">selling_unit_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  product_a [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">カテゴリID<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品コード<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_code</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品名<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準販売単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_selling_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準仕入単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_purchase_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  shipment [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>出荷</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">shipment</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">出荷ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">shipment_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">会員ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">member_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">出荷日<BR/><FONT POINT-SIZE="9" COLOR="#555555">shipped_on</FONT></TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
  stock_out [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffebee"><TR><TD BGCOLOR="#c62828" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>出庫</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">stock_out</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">出庫ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">stock_out_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">受注明細ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">sales_order_detail_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">出荷ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">shipment_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">出庫数量<BR/><FONT POINT-SIZE="9" COLOR="#555555">shipped_quantity</FONT></TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
  product_b [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e8f5e9"><TR><TD BGCOLOR="#2e7d32" COLSPAN="3" CELLPADDING="6"><FONT COLOR="white"><B>商品</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">product</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">PK</TD><TD ALIGN="LEFT">商品ID<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">FK</TD><TD ALIGN="LEFT">カテゴリID<BR/><FONT POINT-SIZE="9" COLOR="#555555">category_id</FONT></TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品コード<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_code</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">商品名<BR/><FONT POINT-SIZE="9" COLOR="#555555">product_name</FONT></TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準販売単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_selling_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR><TR><TD ALIGN="CENTER" WIDTH="28">&nbsp;</TD><TD ALIGN="LEFT">標準仕入単価<BR/><FONT POINT-SIZE="9" COLOR="#555555">standard_purchase_price</FONT></TD><TD ALIGN="LEFT">DECIMAL</TD></TR></TABLE>>];
  { rank=same; sales_order; sales_order_detail; product_a; }
  { rank=same; shipment; }
  { rank=same; stock_out; product_b; }
  member -> sales_order [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="受注する", fontsize=10, fontname="Hiragino Sans"];
  member -> shipment [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="配送先となる", fontsize=10, fontname="Hiragino Sans"];
  sales_order -> sales_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="内訳を持つ", fontsize=10, fontname="Hiragino Sans"];
  product_a -> sales_order_detail [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="受注対象となる", fontsize=10, fontname="Hiragino Sans"];
  sales_order_detail -> stock_out [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="分割して出庫されうる", fontsize=10, fontname="Hiragino Sans"];
  shipment -> stock_out [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="まとめて出庫されうる", fontsize=10, fontname="Hiragino Sans"];
  product_b -> stock_out [dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2, label="出庫対象となる", fontsize=10, fontname="Hiragino Sans"];
}
